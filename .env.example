# URL et clé anon du projet Supabase (Project Settings → API). Ces deux valeurs
# sont conçues pour être publiques (exposées au navigateur), elles sont protégées
# par les policies RLS définies dans supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé service_role — SECRÈTE, ne jamais exposer au client ni committer.
# Utilisée uniquement par les scripts locaux (scripts/create-admin.ts, scripts/seed.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
